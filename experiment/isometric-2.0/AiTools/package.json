{
  "name": "iso2-aitools",
  "version": "1.0.0",
  "description": "MCP server: SVG renderer with isometric diamond mode for Iso 2.0 experiment",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@resvg/resvg-js --external:@modelcontextprotocol/sdk --external:zod --external:@napi-rs/canvas && echo Built OK",
    "typecheck": "tsc --noEmit",
    "dev": "tsx index.ts",
    "cli": "tsx cli.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx/esm --test renderer.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@napi-rs/canvas": "^0.1.96",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.27.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
