{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "index.ts", "svg-renderer-tool.ts", "proof-renderer.ts",
    "scene-registry.ts", "game-tile-renderer.ts", "cli.ts", "renderer.test.ts",
    "../src/solver.ts", "../src/types.ts"
  ],
  "exclude": ["node_modules", "dist", "test-assets", "smoke-test.ts", "server.ts"]
}
