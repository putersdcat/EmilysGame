{
  "name": "emilys-game",
  "version": "0.0.1",
  "description": "Procedural LLM-Driven Isometric Adventure Game",
  "type": "module",
  "scripts": {
    "dev": "npm run sync-soundfonts && npm run build-wasm && vite",
    "build": "npm run sync-soundfonts && npm run build-wasm && vite build",
    "build:pages": "npm run sync-soundfonts && npm run build-wasm && vite build --mode pages",
    "build-wasm": "cd wasm && npx asc assembly/index.ts --target release && cd .. && node -e \"const fs=require('fs');fs.mkdirSync('public/wasm',{recursive:true});fs.copyFileSync('wasm/build/release.wasm','public/wasm/release.wasm')\"",
    "build-wasm:debug": "cd wasm && npx asc assembly/index.ts --target debug",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npx playwright test --reporter=line",
    "test:core": "npx playwright test tests/core/ --reporter=line",
    "test:audio": "npx playwright test tests/audio/ --reporter=line",
    "test:rendering": "npx playwright test tests/rendering/ --reporter=line",
    "test:sprites": "npx playwright test tests/sprites/ --reporter=line",
    "test:world-gen": "npx playwright test tests/world-gen/ --reporter=line",
    "test:education": "npx playwright test tests/education/ --reporter=line",
    "test:ui": "npx playwright test tests/ui/ --reporter=line",
    "test:gameplay": "npx playwright test tests/gameplay/ --reporter=line",
    "test:perf": "npx playwright test tests/perf/ --reporter=line",
    "test:quick": "npx playwright test tests/core/ tests/audio/ --reporter=line",
    "screenshot": "npm run sync-soundfonts && tsx scripts/capture-screenshot.ts",
    "convert-midi": "tsx scripts/convert-midi.ts",
    "generate-sfx": "tsx scripts/generate-sfx-samples.ts",
    "sync-soundfonts": "tsx scripts/sync-soundfonts.ts",
    "generate:ab-tests": "tsx scripts/generate-asset-ab-tests.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.0.0",
    "assemblyscript": "^0.28.9",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "midi-player-js": "^2.0.16",
    "piano-mp3": "^1.0.2"
  }
}
